From fbd8061fcd70dcdb9af802cd69085ee4efbce675 Mon Sep 17 00:00:00 2001
From: j3ssie <j3ssiejjj@gmail.com>
Date: Sat, 10 Oct 2026 21:57:36 +0800
Subject: [PATCH 7/9] ci: run the CI workflow only on manual dispatch

The full suite is long, so pushes, pull requests and the nightly schedule no
longer trigger it. Start it from the Actions tab or `gh workflow run ci.yml`;
`-f macos=true` adds the macOS job.
---
 .github/workflows/ci.yml     | 26 ++++++++++++--------------
 docs/development/building.md |  3 ++-
 2 files changed, 14 insertions(+), 15 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 5b13b51a..fa928a8c 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -1,21 +1,18 @@
 name: CI
 
-# Runs on every push to main, every pull request, nightly (which is also the
-# only time macOS runs besides main pushes), and on demand from the Actions tab
-# or `gh workflow run ci.yml`.
+# Manual only: the full suite is long, so it runs on demand from the Actions
+# tab or `gh workflow run ci.yml` (add `-f macos=true` for the macOS job).
+# Pushes and pull requests do not trigger it.
 on:
-  push:
-    branches: [main]
-  pull_request:
-  schedule:
-    - cron: "17 3 * * *"
   workflow_dispatch:
+    inputs:
+      macos:
+        description: Also run the macOS (arm64) job (10x minutes)
+        default: false
+        type: boolean
 
-# Cancel superseded PR runs to save CI minutes. Runs on main are never
-# cancelled, so every main commit gets a complete result.
 concurrency:
   group: ci-${{ github.workflow }}-${{ github.ref }}
-  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
 
 permissions:
   contents: read
@@ -174,8 +171,8 @@ jobs:
   macos:
     name: macOS (arm64)
     runs-on: macos-14
-    # macOS minutes cost 10x, so this runs on main pushes and nightly only.
-    if: github.event_name == 'schedule' || (github.event_name == 'push' && github.ref == 'refs/heads/main')
+    # macOS minutes cost 10x, so this runs only when the run asks for it.
+    if: inputs.macos
     steps:
       - uses: actions/checkout@v6
 
@@ -347,7 +344,8 @@ jobs:
     name: Dependency review
     runs-on: ubuntu-latest
     # Diffs the dependency graph against the PR base for known-vulnerable or
-    # license-incompatible additions; only meaningful on pull requests.
+    # license-incompatible additions; only meaningful on pull requests, so it
+    # is skipped while CI is manual-only.
     if: github.event_name == 'pull_request'
     # Non-blocking for now (mirrors the govulncheck stance): surface advisories
     # for triage rather than hard-failing unrelated PRs.
diff --git a/docs/development/building.md b/docs/development/building.md
index 11269c7f..27cd176b 100644
--- a/docs/development/building.md
+++ b/docs/development/building.md
@@ -158,7 +158,8 @@ deliberately conservative and kept green so `make lint` can gate CI:
 
 ## CI
 
-`.github/workflows/ci.yml` runs lint, `go vet`, race-disabled unit tests with a
+`.github/workflows/ci.yml` runs only when started by hand (Actions tab or
+`gh workflow run ci.yml`; `-f macos=true` adds the macOS job). It runs lint, `go vet`, race-disabled unit tests with a
 coverage floor (`coverage-gate`, `COVERAGE_MIN`), plus informational
 `govulncheck`, SBOM (CycloneDX), and dependency-review jobs. The vendored
 `pkg/spitolas/rod` package and everything under `platform/` are excluded from
-- 
